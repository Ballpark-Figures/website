# Generated site output (built by build.py; published by CI)
/_site/

# Wrangler CLI cache (from local `wrangler pages deploy`)
/.wrangler/

# Python
__pycache__/
*.py[cod]

# Machine-local Claude tooling, linked in by /sync-videos — commands is a symlink
# to the private dotclaude repo, settings.local.json a real copy. Keep both OUT of
# this public repo (matches the other sub-repos' .gitignore).
.claude/commands
.claude/settings.local.json

# CLAUDE.md import copies — REAL COPIES of bpkfigures/CLAUDE.md + dotclaude/CLAUDE.md,
# refreshed every session by the SessionStart hook (dotclaude/hooks/refresh-claude-imports.py)
# and imported by CLAUDE.md. They must be real files INSIDE the repo because a
# CLAUDE.md @import will not resolve outside the project dir. This repo is PUBLIC, so
# CLAUDE.private.md (private-repo content) MUST stay ignored — never commit it here.
/CLAUDE.shared.md
/CLAUDE.private.md

.DS_Store
